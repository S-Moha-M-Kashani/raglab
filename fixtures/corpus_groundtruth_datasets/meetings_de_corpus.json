{
  "corpus_dataset_metadata": {
    "dataset": "meetings-de",
    "name": "Team meeting notes (German)",
    "language": "de",
    "description": "Synthetic German weekly meeting notes for a fictional software team over six months. A third script family, compound nouns and dates written in words — where an English-only embedder separates sharply from a multilingual one. All names, companies and events are fictional.",
    "label_fields": {
      "meeting_date": {
        "type": "string",
        "format": "date-time",
        "description": "The day of the weekly meeting this note is from.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "What the meeting covered.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ]
      },
      "threads": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "A topic that runs across several meetings.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ]
      },
      "role": {
        "type": "string",
        "values": [
          "user",
          "assistant"
        ],
        "description": "Who produced the turn.",
        "applies_to": [
          "part",
          "chunk",
          "summary"
        ]
      },
      "mood_label": {
        "type": "string",
        "description": "How the meeting's mood was described, when noted. Recorded on a few meetings only.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ]
      },
      "mood_valence": {
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "description": "How positive the noted mood was, 0 (very negative) to 10 (very positive). The importance source: rescaled to 0-1, this is what the agentic retriever's third weight reads. Recorded on a few meetings only; a corpus without it is not measured any differently.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ],
        "ranks": true
      },
      "mood_arousal": {
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "description": "How energised the noted mood was, 0 (very calm) to 10 (very activated). Recorded on a few meetings only.",
        "applies_to": [
          "document",
          "chunk",
          "summary"
        ]
      }
    }
  },
