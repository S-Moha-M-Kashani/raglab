#!/bin/sh
# pre-push — an allowlist. Only the published branch and its version tags may
# leave this machine.
#
# Git feeds one line per ref on stdin: "<local-ref> <local-sha> <remote-ref>
# <remote-sha>". A non-zero exit cancels the whole push before anything is
# sent. The check is on the *local* ref, so `git push origin development:main`
# — the same content wearing another name — is refused too.
#
# Deliberately an allowlist: a blocklist naming `development` would wave the
# next branch anyone creates straight through, which is the one failure this
# shape cannot have.
#
# Consequence worth knowing: `git push --all` always fails while any other
# branch exists, because one refused ref aborts the whole push. Publish by
# naming the branch.

remote_name=${1:-origin}
current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")

published=main
git show-ref --verify --quiet refs/heads/main || published=master

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
    "refs/heads/$published") continue ;;
    refs/tags/v*)            continue ;;
    "(delete)")              continue ;;
    HEAD)
        if [ "$current" = "$published" ]; then
            continue
        fi
        ;;
    esac
    echo "refused: only $published and its v* tags are published." >&2
    echo "  offending ref: $local_ref -> ${remote_ref:-?}" >&2
    status=1
done

if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "The remote is the record of what shipped. development, feature/* and" >&2
    echo "archive/* tags stay on this machine." >&2
    echo "Publish with: git push $remote_name $published --follow-tags" >&2
fi
exit "$status"
