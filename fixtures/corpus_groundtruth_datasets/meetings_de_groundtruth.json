        "description": "Evaluation category.",
        "applies_to": [
          "question"
        ]
      },
      "difficulty": {
        "type": "string",
        "values": [
          "easy",
          "medium",
          "hard"
        ],
        "description": "Human-assigned difficulty.",
        "applies_to": [
          "question"
        ]
      },
      "question_translation_en": {
        "type": "string",
        "description": "English translation, for analysis. Not the retrieval query.",
        "applies_to": [
          "question"
        ]
      },
      "time_scope": {
        "type": "object",
        "nullable": true,
        "description": "Inclusive from/to date range resolved from a time expression in the question; null when the question needs no range.",
        "applies_to": [
          "question"
        ]
      }
    },
    "evidence_role_values": {
      "supporting": "The quote supports the expected answer.",
      "contradicting": "The quote contradicts the question's false premise."
    }
  },
